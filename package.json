{
  "name": "diafanador-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" index.html \"public/**/*.{html,css,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" index.html \"public/**/*.{html,css,js}\""
  },
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vue-tsc": "^2.0.0",
    "prettier": "^3.6.2"
  }
}
